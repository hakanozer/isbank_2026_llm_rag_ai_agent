# Uygulama
APP_NAME="AI Commerce Assistant"
APP_ENV=development
DEBUG=true
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL (Docker)
POSTGRES_USER=aicommerce
POSTGRES_PASSWORD=changeme123
POSTGRES_DB=aicommerce_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aicommerce:changeme123@localhost:5432/aicommerce_db

# LLM (Ollama yerel model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding modeli (sentence-transformers)
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# FAISS vector store yolu
VECTOR_STORE_PATH=./vector_store/products.faiss

# ELK log forwarding (local app -> logstash)
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5514